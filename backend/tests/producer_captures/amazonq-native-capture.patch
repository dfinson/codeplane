+    #[tokio::test]
+    async fn codeplane_native_capture() {
+        let mut os = Os::new().await.unwrap();
+        os.client.set_mock_output(serde_json::json!([
+            ["Addition combines two numbers in this inert fixture."],
+            ["The synthetic example gives 5."]
+        ]));
+        let agents = get_test_agents(&os).await;
+        let tool_config = serde_json::from_str::<HashMap<String, ToolSpec>>(include_str!("tools/tool_index.json"))
+            .expect("native tool definitions");
+        ChatSession::new(
+            &mut os,
+            "codeplane-native-capture",
+            agents,
+            None,
+            InputSource::new_mock(vec![
+                "Describe addition in this synthetic AmazonQ fixture.".to_string(),
+                "Use the synthetic example 2 plus 3.".to_string(),
+                "/quit".to_string(),
+            ]),
+            false,
+            || Some(80),
+            ToolManager::default(),
+            None,
+            tool_config,
+            true,
+            false,
+            None,
+        )
+        .await
+        .unwrap()
+        .spawn(&mut os)
+        .await
+        .unwrap();
+        let cwd = std::env::current_dir().unwrap();
+        let saved = os.database.get_conversation_by_path(&cwd).unwrap().expect("native saved conversation");
+        assert_eq!(saved.conversation_id(), "codeplane-native-capture");
+        let raw = os.database.codeplane_capture_raw_conversation(&cwd);
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&raw).unwrap()["history"]
+                .as_array().unwrap().len(),
+            2
+        );
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&raw).unwrap(),
+            serde_json::to_value(saved).unwrap()
+        );
+        std::fs::write(std::env::var("CODEPLANE_AMAZONQ_CAPTURE").unwrap(), raw).unwrap();
+    }
